def choose_monitor(monitors: list[dict]) -> int:







    print("\nДоступные области захвата:")







    for index, monitor in enumerate(monitors):







        label = "Все мониторы (единый рабочий стол)" if index == 0 else f"Монитор {index}"







        print(







            f"  {index}: {label} — {monitor['width']}x{monitor['height']} "







            f"(x={monitor['left']}, y={monitor['top']})"







        )







    default = 1 if len(monitors) > 1 else 0







    while True:







        raw = input(f"\nНомер области для захвата [Enter = {default}]: ").strip()







        if not raw:







            return default







        try:







            selected = int(raw)







        except ValueError:







            print("Введите номер цифрами.")







            continue







        if 0 <= selected < len(monitors):







            return selected







        print(f"Допустимый диапазон: 0–{len(monitors) - 1}.")























def capture_rgb(sct: mss.MSS, monitor: dict) -> Image.Image:







    shot = sct.grab(monitor)







    return Image.frombytes("RGB", shot.size, shot.rgb)



def get_cursor_position(monitor: dict) -> tuple[int, int] | None:
    """Получить позицию мыши относительно выбранного монитора."""
    try:
        user32 = ctypes.WinDLL("user32", use_last_error=True)
        get_cursor_pos = user32.GetCursorPos
        get_cursor_pos.argtypes = [ctypes.POINTER(wintypes.POINT)]
        get_cursor_pos.restype = wintypes.BOOL
        point = wintypes.POINT()
        if not get_cursor_pos(ctypes.byref(point)):
            return None
        x = int(point.x) - int(monitor.get("left", 0))
        y = int(point.y) - int(monitor.get("top", 0))
        if 0 <= x < int(monitor.get("width", 0)) and 0 <= y < int(monitor.get("height", 0)):
            return (x, y)
        return None
    except Exception:
        return None


def encode_cursor_crop_for_model(
    image: Image.Image, cursor_pos: tuple[int, int] | None
) -> bytes | None:
    """Увеличенный фрагмент того же кадра вокруг положения игрового курсора."""
    if cursor_pos is None:
        return None
    try:
        x, y = int(cursor_pos[0]), int(cursor_pos[1])
        crop_w, crop_h = min(360, image.width), min(270, image.height)
        left = max(0, min(image.width - crop_w, x - crop_w // 2))
        top = max(0, min(image.height - crop_h, y - crop_h // 2))
        crop = image.crop((left, top, left + crop_w, top + crop_h))
        resampling = getattr(Image, "Resampling", Image)
        crop = crop.resize((crop.width * 2, crop.height * 2), resampling.LANCZOS)
        buffer = io.BytesIO()
        crop.save(buffer, format="JPEG", quality=92, optimize=True)
        return buffer.getvalue()
    except Exception:
        return None























def make_diff_image(image: Image.Image) -> Image.Image:







    return image.resize(DIFF_SIZE, Image.Resampling.BILINEAR).convert("L")























def changed_ratio(reference: Image.Image, current: Image.Image) -> tuple[float, float]:







    diff = ImageChops.difference(reference, current)







    mean_difference = ImageStat.Stat(diff).mean[0]







    histogram = diff.histogram()







    changed_pixels = sum(histogram[CHANGE_PIXEL_THRESHOLD + 1 :])







    ratio = changed_pixels / (DIFF_SIZE[0] * DIFF_SIZE[1])







    return ratio, mean_difference























def encode_for_model(image: Image.Image) -> bytes:







    if image.width > MAX_IMAGE_WIDTH:







        new_height = round(image.height * MAX_IMAGE_WIDTH / image.width)







        image = image.resize((MAX_IMAGE_WIDTH, new_height), Image.Resampling.LANCZOS)







    buffer = io.BytesIO()







    image.save(buffer, format="JPEG", quality=90, optimize=True)







    return buffer.getvalue()























def encode_hud_for_model(image: Image.Image) -> bytes:



    left, top, right, bottom = HUD_CROP_BOX







    if image.width < right or image.height < bottom:



        raise ValueError(



            f"HUD crop requires at least {right}x{bottom}, "



            f"but captured image is {image.width}x{image.height}"



        )







    hud = image.crop(HUD_CROP_BOX)



    hud = hud.resize(



        (hud.width * HUD_UPSCALE, hud.height * HUD_UPSCALE),



        Image.Resampling.LANCZOS,



    )







    buffer = io.BytesIO()



    hud.save(buffer, format="JPEG", quality=95, optimize=True)



    return buffer.getvalue()











def encode_hud_context_for_model(image: Image.Image) -> bytes:
    # Full screen for reading tooltips outside the HUD crop.
    max_width = 1440

    if image.width > max_width:
        new_height = round(image.height * max_width / image.width)
        image = image.resize(
            (max_width, new_height),
            Image.Resampling.LANCZOS,
        )

    buffer = io.BytesIO()
    image.save(buffer, format="JPEG", quality=92, optimize=True)
    return buffer.getvalue()


def encode_reference_atlas_for_model(path: Path, max_width: int = 1280) -> bytes:
    with Image.open(path) as source_image:
        reference = source_image.convert("RGB")
    if reference.width > max_width:
        resampling = getattr(Image, "Resampling", Image)
        height = max(1, int(reference.height * max_width / reference.width))
        reference = reference.resize((max_width, height), resampling.LANCZOS)
    buffer = io.BytesIO()
    reference.save(buffer, format="JPEG", quality=88, optimize=True)
    return buffer.getvalue()


def encode_tooltip_crop_for_model(image: Image.Image) -> bytes | None:
    """Увеличенный фрагмент левой центральной области, где Quasimorph показывает hover-tooltip."""
    try:
        width, height = image.size
        crop_w = min(720, width)
        crop_h = min(600, height)
        left = 0
        top = max(0, (height - crop_h) // 2)
        crop = image.crop((left, top, left + crop_w, top + crop_h))

        # Enlarge text for OCR-like visual reading without making the image excessive.
        scale = min(1.25, 960 / max(1, crop.width), 800 / max(1, crop.height))
        if scale > 1.0:
            resampling = getattr(Image, "Resampling", Image)
            new_size = (
                max(1, int(crop.width * scale)),
                max(1, int(crop.height * scale)),
            )
            crop = crop.resize(new_size, resampling.LANCZOS)

        buffer = io.BytesIO()
        crop.save(buffer, format="JPEG", quality=93, optimize=True)
        return buffer.getvalue()
    except Exception:
        return None


