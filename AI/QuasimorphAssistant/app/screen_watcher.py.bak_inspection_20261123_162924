        "\u0436\u0443\u0440\u043d\u0430\u043b: "
        "\u0442\u043e\u043b\u044c\u043a\u043e "
        "\u0447\u0438\u0442\u0430\u0435\u043c\u044b\u0435 "
        "\u0441\u043e\u0431\u044b\u0442\u0438\u044f\n"
        "\u041e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435: "
        "\u043e\u0442\u043a\u0443\u0434\u0430 "
        "\u0438\u0434\u0451\u0442 "
        "\u043f\u043e\u043b\u043e\u0441\u043a\u0430 "
        "\u0437\u0434\u043e\u0440\u043e\u0432\u044c\u044f "
        "\u0438\u043b\u0438 \u043b\u0438\u043d\u0438\u044f\n"
        "\u041d\u0435\u0443\u0432\u0435\u0440\u0435\u043d\u043d\u043e\u0441\u0442\u044c: "
        "\u043a\u0430\u043a\u0438\u0435 "
        "\u0432\u044b\u0432\u043e\u0434\u044b "
        "\u043d\u0435 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u044b."
    )

    def run_one(
        label: str,
        system_text: str,
        user_text: str,
        image_data: bytes | list[bytes],
        max_tokens: int,
    ) -> str:
        image_list = (
            image_data if isinstance(image_data, list)
            else [image_data]
        )

        messages = [
            {"role": "system", "content": system_text},
            {"role": "user", "content": user_text, "images": image_list},
        ]

        try:
            response = client.chat(
                model=MODEL,
                messages=messages,
                keep_alive=MODEL_KEEP_ALIVE,
                options={
                    "temperature": 0.1,
                    "num_predict": max_tokens,
                    "num_ctx": 10240,
                },
            )

            content = (response.message.content or "").strip()

            if not content:
                response = client.chat(
                    model=MODEL,
                    messages=messages,
                    keep_alive=MODEL_KEEP_ALIVE,
                    options={
                        "temperature": 0.1,
                        "num_predict": max_tokens,
                        "num_ctx": 10240,
                    },
                )
                content = (response.message.content or "").strip()

            if content:
                return content

            return (
                "\u041c\u043e\u0434\u0435\u043b\u044c "
                "\u0432\u0435\u0440\u043d\u0443\u043b\u0430 "
                "\u043f\u0443\u0441\u0442\u043e\u0439 "
                "\u043e\u0442\u0432\u0435\u0442."
            )

        except Exception as exc:
            return (
                "\u041e\u0448\u0438\u0431\u043a\u0430 "
                "\u0430\u043d\u0430\u043b\u0438\u0437\u0430 "
                f"{label}: {exc}"
            )

    # HUD gets the full screen for tooltips plus the enlarged crop for numbers.
    hud_report = run_one(
        "HUD",
        hud_system,
        hud_prompt,
        [hud_context_bytes, hud_image_bytes],
        220,
    )

    # CURSOR_ATLAS_REFERENCE_INTEGRATION_V1
    # The atlas is optional: if it is missing or unreadable, gameplay analysis
    # continues with the screenshot alone, exactly as before.
    scene_images = [hud_context_bytes]
    cursor_atlas_path = (
        Path(__file__).resolve().parents[1]
        / "knowledge"
        / "cursor_examples"
        / "cursor_atlas.png"
    )

    try:
        with Image.open(cursor_atlas_path) as atlas_source:
            cursor_atlas_image = atlas_source.convert("RGB")
            resampling = getattr(Image, "Resampling", Image)
            cursor_atlas_image.thumbnail(
                (1440, 1440),
                getattr(resampling, "LANCZOS"),
            )
            atlas_buffer = io.BytesIO()
            cursor_atlas_image.save(
                atlas_buffer,
                format="JPEG",
                quality=88,
                optimize=True,
            )
            cursor_atlas_bytes = atlas_buffer.getvalue()

        if cursor_atlas_bytes:
            scene_images.append(cursor_atlas_bytes)
            scene_system += (
                "\n\nCURSOR REFERENCE ATLAS — IMAGE 2:\n"
                "Image 1 is the current gameplay screenshot. Image 2 is a "
                "labeled atlas of in-game Quasimorph cursor states collected "
                "from this user's game. Compare the cursor visible in Image 1 "
                "with the examples in Image 2. The atlas shows the rendered "
                "in-game cursor and its local context; it is NOT a separate "
                "Windows mouse-pointer image.\n"
                "Recognize these categories when visually supported: ordinary "
                "floor cell, movement-available cell/path, enemy hover, ally "
                "hover, corpse hover, blocked tile, interactable object, "
                "inventory item, aiming/attack, or other. If the cursor does "
                "not clearly match an example, report its state as uncertain "
                "rather than forcing a category.\n"
                "Use cursor appearance only as an AUXILIARY clue to locate or "
                "understand the currently hovered target. It does not prove "
                "that a character is an enemy or ally and must NEVER override "
                "the target's own health-bar evidence: green linked bar = "
                "FRIEND, red linked bar = ENEMY, unclear/missing bar = SIDE "
                "UNKNOWN. A cursor icon or its color is not a health bar. "
                "A corpse-hover cursor can support corpse identification, "
                "but do not call a body dead from cursor appearance alone.\n"
                "Do not use cursor appearance alone to identify the player. "
                "Keep the existing movement-path-origin and aiming-line-origin "
                "requirements for player identification.\n"
            )
            scene_prompt += (
                "\n\nFIFTH: compare the visible IN-GAME cursor in the "
                "screenshot with the labeled reference atlas (Image 2). "
                "Report its state only when the visual match is clear; "
                "otherwise say it is uncertain. State what object or cell "
                "it appears to be over only when that association is visible. "
                "Use this as supporting evidence, never as a replacement "
                "for an NPC's directly linked health bar or the player-origin "
                "identification rules.\n"
                "Курсор: состояние и объект под ним, если надёжно определяются"
            )
    except (OSError, ValueError) as exc:
        if not getattr(ask_model, "_cursor_atlas_warning_shown", False):
            print(
                f"[WARN] Cursor atlas unavailable ({cursor_atlas_path}): {exc}. "
                "Gameplay analysis will continue without it.",
                flush=True,
            )
            ask_model._cursor_atlas_warning_shown = True

    # CURSOR_INTELLIGENCE_PATCH_V1
    # The crop and cursor coordinates belong to this exact submitted frame.
    cursor_crop_bytes = encode_cursor_crop_for_model(image, cursor_pos)
    if cursor_crop_bytes:
        cursor_image_number = len(scene_images) + 1
        scene_images.append(cursor_crop_bytes)
        scene_system += (
            f"\n\nCURRENT CURSOR CROP — IMAGE {cursor_image_number}:\n"
            "An enlarged crop of the CURRENT screenshot around the Windows "
            "mouse position. Inspect the rendered IN-GAME cursor and the "
            "tile/object under it. The crop is from this same frame, not a "
            "separate Windows cursor picture. If no in-game cursor is visible, "
            "say so; do not guess.\n"
        )
        scene_prompt += (
            f"\n\nInspect IMAGE {cursor_image_number} as the enlarged current "
            "cursor area. Report the cursor state and hovered target only "
            "when visually supported. Cursor appearance never replaces a "
            "directly linked health bar.\n"
            "Курсор: состояние и объект под ним, если различимы.\n"
        )

    contact_atlas_path = (
        Path(__file__).resolve().parents[1]
        / "knowledge" / "contact_examples" / "contact_atlas.jpg"
    )
    try:
        contact_atlas_bytes = encode_reference_atlas_for_model(contact_atlas_path)
        contact_image_number = len(scene_images) + 1
        scene_images.append(contact_atlas_bytes)
        scene_system += (
            f"\n\nSNEAK CONTACT REFERENCE ATLAS — IMAGE {contact_image_number}:\n"
            "Reference-only examples from the user's Quasimorph screenshots. "
            "GREEN examples represent friendly detected contacts outside "
            "direct line of sight; RED examples represent hostile detected "
            "contacts. The atlas itself is NOT evidence that a contact exists "
            "in the current scene. Report only markers actually visible in "
            "the CURRENT gameplay screenshot. A contact icon is not a body "
            "and must not be counted as a visible NPC.\n"
            "Do not confuse contact icons with health bars, cursor icons, "
            "inventory indicators or unrelated minimap symbols. If shape or "
            "color is unclear, mark the contact as ambiguous. If the body "
            "is visible, classify it from its own directly linked health bar.\n"
        )
        scene_prompt += (
            f"\n\nSIXTH: compare the CURRENT screenshot with IMAGE {contact_image_number}. "
            "List clearly visible red/green contact icons separately from "
            "visible NPC bodies. Give approximate screen position only; do "
            "not invent world coordinates. Do not copy contacts from the "
            "reference atlas into the current scene. If an entity is both "
            "visible as a body and represented by a marker, do not count it "
            "twice.\n"
            "If '?' or '!' is clearly attached to an enemy, report the symbol "
            "and its state separately: '?' means investigating; '!' means "
            "alerted/engaging. Report only symbols actually visible, not "
            "inferred reactions to sounds.\n"
            "Add concise Russian sections:\n"
            "Контакты вне прямой видимости: красные / зелёные / неоднозначные "
            "маркеры и примерное положение, либо нет.\n"
            "Состояние тревоги: видимые '?'/'!' и связанный NPC, либо не видно.\n"
        )
    except (OSError, ValueError) as exc:
        if not getattr(ask_model, "_contact_atlas_warning_shown", False):
            print(
                f"[WARN] Contact atlas unavailable ({contact_atlas_path}): {exc}. "
                "Gameplay analysis will continue without contact references.",
                flush=True,
            )
            ask_model._contact_atlas_warning_shown = True

    # HOVER_TOOLTIP_PATCH_V1
    # Quasimorph's contextual hover tooltip appears along the left edge, around mid-screen.
    # This crop is made from the SAME submitted frame as the full screenshot and cursor crop.
    tooltip_crop_bytes = encode_tooltip_crop_for_model(image)
    if tooltip_crop_bytes:
        tooltip_image_number = len(scene_images) + 1
        scene_images.append(tooltip_crop_bytes)
        scene_system += (
            f"\n\nHOVER TOOLTIP CROP — IMAGE {tooltip_image_number}:\n"
            "This is an enlarged crop of the LEFT-CENTRE region of the SAME current "
            "gameplay screenshot. In Quasimorph, hovering an NPC or an interactive "
            "world object (including doors) displays a contextual tooltip in this "
            "left-side area; it does not require opening the inventory. Read the "
            "tooltip's exact visible name and description when present.\n"
            "Use the tooltip as the PRIMARY clue for identifying the object under "
            "the current in-game cursor. Match it to a visible body or object only "
            "when the full screenshot and cursor crop make that association clear.\n"
            "A tooltip may identify an NPC, door, mechanism, or other object. It "
            "does NOT by itself prove FRIEND or ENEMY: classify an NPC's side only "
            "from its own directly linked green/red health bar or a clearly "
            "identified Sneak contact marker. Do not treat tooltip text or numbers "
            "as HUD statistics. If text is cropped, obscured, absent or unreadable, "
            "state that; never reconstruct missing words.\n"
            "Do not mistake the tooltip for the inventory panel on the right.\n"
        )
        scene_prompt += (
            f"\n\nSEVENTH: inspect IMAGE {tooltip_image_number}, the enlarged "
            "left-centre hover-tooltip area from the same frame. If a contextual "
            "tooltip is visible, transcribe its readable name and relevant "
            "description faithfully. Identify the hovered target as an NPC, door, "
            "mechanism or other object only when the association is clear. The "
            "tooltip identifies WHAT is under the cursor; it does not establish "
            "NPC allegiance unless allegiance is explicitly stated. Green/red "
            "health-bar linkage remains the authority for FRIEND/ENEMY.\n"
            "Return a compact section in Russian:\n"
            "Подсказка наведения: точный читаемый текст или «не видна»; "
            "цель под курсором и тип, если надёжно определяются.\n"
            "If the tooltip is absent or unreadable, say so briefly. Do not guess.\n"
        )

    # Gameplay gets the full screenshot and, when available, the cursor atlas.
    scene_report = run_one(
        "gameplay",
        scene_system,
        scene_prompt,
        scene_images,
        620,
    )

    return (
        "=== HUD: \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438 "
        "\u043d\u0430\u0451\u043c\u043d\u0438\u043a\u0430 ===\n"
        + hud_report
        + "\n\n=== "
        "\u0418\u0433\u0440\u043e\u0432\u0430\u044f "
        "\u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f ===\n"
        + scene_report
    )


class SharedFrame:







    def __init__(self) -> None:







        self.lock = threading.Lock()







        self.image: Image.Image | None = None
        self.cursor_pos: tuple[int, int] | None = None







        self.captured_at = 0.0







        self.error: Exception | None = None







        self.ready = threading.Event()















    def set_image(
        self, image: Image.Image, cursor_pos: tuple[int, int] | None = None
    ) -> None:







        with self.lock:







            self.image = image.copy()
            self.cursor_pos = cursor_pos
            self.captured_at = time.monotonic()







        self.ready.set()















    def get(self) -> tuple[Image.Image | None, float]:







        with self.lock:







            return self.image.copy() if self.image is not None else None, self.captured_at


    def get_with_cursor(
        self,
    ) -> tuple[Image.Image | None, float, tuple[int, int] | None]:
        with self.lock:
            image = self.image.copy() if self.image is not None else None
            return image, self.captured_at, self.cursor_pos























def capture_worker(stop_event: threading.Event, shared: SharedFrame, monitor: dict) -> None:







    try:







        with mss.MSS() as sct:







            while not stop_event.is_set():







                frame = capture_rgb(sct, monitor)
                cursor_pos = get_cursor_position(monitor)
                shared.set_image(frame, cursor_pos)







                stop_event.wait(CAPTURE_INTERVAL_SECONDS)







    except Exception as exc:







        shared.error = exc







        shared.ready.set()







        stop_event.set()























def model_worker(stop_event: threading.Event, jobs: queue.Queue, results: queue.Queue) -> None:







    client = ollama.Client(host=OLLAMA_HOST, timeout=180.0)







    while not stop_event.is_set():







        try:







            job = jobs.get(timeout=0.25)







        except queue.Empty:







            continue







        if job is None:







            jobs.task_done()







            break







        image, reason, cursor_pos = job







        try:







            report = ask_model(client, image, reason, cursor_pos)







            results.put((report, None))







        except Exception as exc:







            results.put((None, exc))







        finally:







            jobs.task_done()























def main() -> int:







    print("=" * 70)







    print("Quasimorph Assistant — Screen Watcher v1.6")







    print(f"Модель: {MODEL}")







    print(f"Захват экрана: каждые {CAPTURE_INTERVAL_SECONDS:.1f} с")







    print(f"Минимальная пауза между анализами: {ANALYSIS_COOLDOWN_SECONDS:.0f} с")







    print(f"Порог изменения: {CHANGE_RATIO_THRESHOLD * 100:.1f}% пикселей и средняя разница {CHANGE_MEAN_THRESHOLD:.1f}")







    print(f"Контрольный анализ без изменений: каждые {HEARTBEAT_SECONDS:.0f} с")







    print("Сравнение идёт с последним кадром, отправленным Qwen; мелкая анимация фильтруется.")







    print("Qwen получает только текущий кадр — старые отчёты не передаются в контекст.")







    print("Скриншоты не сохраняются и отправляются только локальному Ollama.")







    print("Остановка: Ctrl+C в этом окне.")







    print("=" * 70)















    client = ollama.Client(host=OLLAMA_HOST, timeout=30.0)







    try:







        client.list()







    except Exception as exc:







        print(f"Не удалось подключиться к Ollama на {OLLAMA_HOST}: {exc}")







        print("Убедись, что Ollama запущена.")







        return 2















    with mss.MSS() as sct:







        monitors = sct.monitors







        if len(monitors) < 2:







            print("Не удалось обнаружить монитор для захвата.")







            return 3







        selected = choose_monitor(monitors)







        monitor = dict(monitors[selected])















    print("\nПереключись в Quasimorph. Начинаю захват через:")







    for remaining in range(STARTUP_COUNTDOWN_SECONDS, 0, -1):







        print(f"  {remaining}...", end="\r", flush=True)







        time.sleep(1)















    stop_event = threading.Event()







    shared = SharedFrame()







    jobs: queue.Queue = queue.Queue(maxsize=1)







    results: queue.Queue = queue.Queue()







    capture_thread = threading.Thread(target=capture_worker, args=(stop_event, shared, monitor), daemon=True)







    ai_thread = threading.Thread(target=model_worker, args=(stop_event, jobs, results), daemon=True)







    capture_thread.start()







    ai_thread.start()















    if not shared.ready.wait(timeout=10):







        print("Не удалось получить первый кадр с экрана.")







        stop_event.set()







        return 4







    if shared.error:







        print(f"Ошибка захвата экрана: {shared.error}")







        stop_event.set()







        return 5















    initial_image, initial_ts, initial_cursor_pos = shared.get_with_cursor()







    if initial_image is None:







        print("Первый кадр пустой.")







        stop_event.set()







        return 6















    reference_small = make_diff_image(initial_image)







    last_seen_capture_ts = initial_ts







    last_analysis_at = 0.0







    analysis_busy = False







    consecutive_hits = 0







    pending_image: Image.Image | None = None







    pending_reason = ""
    pending_cursor_pos: tuple[int, int] | None = None







    game_focused = is_quasimorph_focused()







    awaiting_game_frame = False







    focus_changed_at = 0.0















    def submit(
        image: Image.Image,
        reason: str,
        cursor_pos: tuple[int, int] | None = None,
    ) -> None:







        nonlocal analysis_busy, last_analysis_at, reference_small, consecutive_hits, pending_image, pending_reason, pending_cursor_pos







        if not is_quasimorph_focused():







            log_line("\u0418\u0433\u0440\u0430 \u043d\u0435 \u0432 \u0444\u043e\u043a\u0443\u0441\u0435 \u2014 \u0430\u043d\u0430\u043b\u0438\u0437 \u043f\u0440\u043e\u043f\u0443\u0449\u0435\u043d")







            return







        try:







            jobs.put_nowait((image.copy(), reason, cursor_pos))







        except queue.Full:







            return







        # Move the comparison baseline to the exact image sent to the model.







        reference_small = make_diff_image(image)







        analysis_busy = True







        last_analysis_at = time.monotonic()







        consecutive_hits = 0







        pending_image = None







        pending_cursor_pos = None







        pending_reason = ""







        log_line(f"Отправлен кадр на анализ: {reason}")















    print("\nНаблюдение запущено. Первичный анализ отправляется модели.", flush=True)







    submit(initial_image, "первичный снимок текущей сессии", initial_cursor_pos)















    try:







        while not stop_event.is_set():







            time.sleep(0.20)















            if shared.error:







                log_line(f"Ошибка захвата экрана: {shared.error}")







                break















            while True:







                try:







                    report, error = results.get_nowait()







                except queue.Empty:







                    break







                analysis_busy = False







                if error is not None:







                    log_line(f"Ошибка анализа Qwen: {error}")







                elif report:







                    log_report(report)







                results.task_done()















            current_focus = is_quasimorph_focused()















            if current_focus != game_focused:







                game_focused = current_focus















                if game_focused:







                    awaiting_game_frame = True







                    focus_changed_at = time.monotonic()







                    log_line(







                        "Quasimorph \u0441\u043d\u043e\u0432\u0430 "







                        "\u0432 \u0444\u043e\u043a\u0443\u0441\u0435 "







                        "\u2014 \u0430\u043d\u0430\u043b\u0438\u0437 "







                        "\u0432\u043e\u0437\u043e\u0431\u043d\u043e\u0432\u043b\u0451\u043d"







                    )







                else:







                    awaiting_game_frame = False







                    pending_image = None







                    pending_cursor_pos = None







                    pending_reason = ""







                    consecutive_hits = 0







                    log_line(







                        "\u0418\u0433\u0440\u0430 \u043d\u0435 "







                        "\u0432 \u0444\u043e\u043a\u0443\u0441\u0435 "







                        "\u2014 \u0430\u043d\u0430\u043b\u0438\u0437 "







                        "\u043f\u0440\u043e\u043f\u0443\u0449\u0435\u043d"







                    )















            current_image, captured_at, current_cursor_pos = shared.get_with_cursor()







            if current_image is not None and captured_at != last_seen_capture_ts:







                last_seen_capture_ts = captured_at







                current_small = make_diff_image(current_image)















                if not game_focused:







                    # Do not retain desktop frames as analysis candidates.







                    reference_small = current_small







                    consecutive_hits = 0







                    pending_image = None







                    pending_cursor_pos = None







                    pending_reason = ""















                elif awaiting_game_frame:







                    # Ignore frames captured before the focus transition.







                    if captured_at >= focus_changed_at:







                        reference_small = current_small







                        pending_image = current_image.copy()







                        pending_cursor_pos = current_cursor_pos







                        pending_reason = "Quasimorph returned to foreground"







                        consecutive_hits = 0







                        awaiting_game_frame = False















                else:







                    ratio, mean_diff = changed_ratio(







                        reference_small, current_small







                    )







                    changed_enough = (







                        ratio >= CHANGE_RATIO_THRESHOLD







                        and mean_diff >= CHANGE_MEAN_THRESHOLD







                    )















                    if changed_enough:







                        consecutive_hits += 1







                        pending_image = current_image.copy()







                        pending_cursor_pos = current_cursor_pos







                        pending_reason = (







                            f"Stable screen change: "







                            f"{ratio * 100:.1f}% of pixels, "







                            f"mean difference {mean_diff:.1f}"







                        )







                    else:







                        consecutive_hits = 0















                    if (







                        consecutive_hits < CONSECUTIVE_CHANGE_HITS







                        and pending_image is not None







                    ):







                        pass















            now = time.monotonic()







            cooldown_passed = (now - last_analysis_at) >= ANALYSIS_COOLDOWN_SECONDS







            heartbeat_due = (now - last_analysis_at) >= HEARTBEAT_SECONDS















            if (game_focused and not awaiting_game_frame







                    and not analysis_busy and cooldown_passed):







                if pending_image is not None:







                    submit(pending_image, pending_reason or "изменение экрана", pending_cursor_pos)







                elif heartbeat_due:







                    latest_image, _, latest_cursor_pos = shared.get_with_cursor()







                    if latest_image is not None:







                        submit(latest_image, "периодическая проверка текущего состояния", latest_cursor_pos)















    except KeyboardInterrupt:







        print("\nОстановка наблюдателя...")







    finally:







        stop_event.set()







        try:







            jobs.put_nowait(None)







        except queue.Full:







            pass







        capture_thread.join(timeout=2.0)







        ai_thread.join(timeout=2.0)







        print("Наблюдение остановлено.")







    return 0























