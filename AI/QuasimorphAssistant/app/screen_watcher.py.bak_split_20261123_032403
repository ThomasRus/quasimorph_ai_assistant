def choose_monitor(monitors: list[dict]) -> int:



    print("\nДоступные области захвата:")



    for index, monitor in enumerate(monitors):



        label = "Все мониторы (единый рабочий стол)" if index == 0 else f"Монитор {index}"



        print(



            f"  {index}: {label} — {monitor['width']}x{monitor['height']} "



            f"(x={monitor['left']}, y={monitor['top']})"



        )



    default = 1 if len(monitors) > 1 else 0



    while True:



        raw = input(f"\nНомер области для захвата [Enter = {default}]: ").strip()



        if not raw:



            return default



        try:



            selected = int(raw)



        except ValueError:



            print("Введите номер цифрами.")



            continue



        if 0 <= selected < len(monitors):



            return selected



        print(f"Допустимый диапазон: 0–{len(monitors) - 1}.")











def capture_rgb(sct: mss.MSS, monitor: dict) -> Image.Image:



    shot = sct.grab(monitor)



    return Image.frombytes("RGB", shot.size, shot.rgb)











def make_diff_image(image: Image.Image) -> Image.Image:



    return image.resize(DIFF_SIZE, Image.Resampling.BILINEAR).convert("L")











def changed_ratio(reference: Image.Image, current: Image.Image) -> tuple[float, float]:



    diff = ImageChops.difference(reference, current)



    mean_difference = ImageStat.Stat(diff).mean[0]



    histogram = diff.histogram()



    changed_pixels = sum(histogram[CHANGE_PIXEL_THRESHOLD + 1 :])



    ratio = changed_pixels / (DIFF_SIZE[0] * DIFF_SIZE[1])



    return ratio, mean_difference











def encode_for_model(image: Image.Image) -> bytes:



    if image.width > MAX_IMAGE_WIDTH:



        new_height = round(image.height * MAX_IMAGE_WIDTH / image.width)



        image = image.resize((MAX_IMAGE_WIDTH, new_height), Image.Resampling.LANCZOS)



    buffer = io.BytesIO()



    image.save(buffer, format="JPEG", quality=90, optimize=True)



    return buffer.getvalue()











def encode_hud_for_model(image: Image.Image) -> bytes:

    left, top, right, bottom = HUD_CROP_BOX



    if image.width < right or image.height < bottom:

        raise ValueError(

            f"HUD crop requires at least {right}x{bottom}, "

            f"but captured image is {image.width}x{image.height}"

        )



    hud = image.crop(HUD_CROP_BOX)

    hud = hud.resize(

        (hud.width * HUD_UPSCALE, hud.height * HUD_UPSCALE),

        Image.Resampling.LANCZOS,

    )



    buffer = io.BytesIO()

    hud.save(buffer, format="JPEG", quality=95, optimize=True)

    return buffer.getvalue()





def ask_model(client: ollama.Client, image: Image.Image, reason: str) -> str:



    image_bytes = encode_for_model(image)

    hud_image_bytes = encode_hud_for_model(image)



    prompt = (



        f"Причина анализа: {reason}.\n"



        "Опиши только то, что действительно видно на этом изображении. "



        "Не сравнивай его с предыдущими кадрами и не вспоминай старые события. "



        "Если текст неразборчив, прямо скажи об этом."



    )



    prompt += (

        "\u0412 \u0437\u0430\u043f\u0440\u043e\u0441\u0435 \u0434\u0432\u0430 "

        "\u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f "

        "\u043e\u0434\u043d\u043e\u0433\u043e \u043a\u0430\u0434\u0440\u0430: "

        "\u043f\u0435\u0440\u0432\u043e\u0435 \u2014 \u043f\u043e\u043b\u043d\u044b\u0439 "

        "\u044d\u043a\u0440\u0430\u043d, \u0432\u0442\u043e\u0440\u043e\u0435 "

        "\u2014 \u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u043d\u044b\u0439 "

        "\u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442 HUD. "

        "\u0414\u043b\u044f \u0447\u0442\u0435\u043d\u0438\u044f "

        "\u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 "

        "\u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0430 "

        "\u0432 \u043f\u0435\u0440\u0432\u0443\u044e \u043e\u0447\u0435\u0440\u0435\u0434\u044c "

        "\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439 "

        "\u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u043d\u043e\u0435 "

        "\u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435. "

        "\u041f\u0435\u0440\u0432\u043e\u0435 "

        "\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439 "

        "\u0434\u043b\u044f \u043e\u0431\u0449\u0435\u0433\u043e "

        "\u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0430. "

        "\u041d\u0435 \u0432\u043e\u0441\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0439 "

        "\u0443\u0432\u0435\u043b\u0438\u0447\u0435\u043d\u043d\u044b\u0439 "

        "\u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442 "

        "\u043a\u0430\u043a \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0439 "

        "\u044d\u043a\u0440\u0430\u043d. "

        "\u0415\u0441\u043b\u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 "

        "\u043d\u0435 \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f, "

        "\u043d\u0435 \u0443\u0433\u0430\u0434\u044b\u0432\u0430\u0439."

    )



    response = client.chat(



        model=MODEL,



        messages=[



            {"role": "system", "content": SYSTEM_PROMPT},



            {"role": "user", "content": prompt, "images": [image_bytes, hud_image_bytes]},



        ],



        keep_alive=MODEL_KEEP_ALIVE,



        options={"temperature": 0.1, "num_predict": 500, "num_ctx": 10240},



    )



    content = (response.message.content or "").strip()



    if content:



        return content







    # One short retry if the model returned an empty final message.



    retry = client.chat(



        model=MODEL,



        messages=[



            {"role": "system", "content": "Кратко и точно опиши только видимые элементы скриншота Quasimorph. Не додумывай."},



            {"role": "user", "content": "Что видно на этом скриншоте? Если определить нельзя, скажи об этом.", "images": [image_bytes, hud_image_bytes]},



        ],



        keep_alive=MODEL_KEEP_ALIVE,



        options={"temperature": 0.1, "num_predict": 300, "num_ctx": 10240},



    )



    content = (retry.message.content or "").strip()



    if content:



        return content



    done_reason = getattr(retry, "done_reason", None) or "unknown"



    eval_count = getattr(retry, "eval_count", None)



    return f"Модель дважды вернула пустой ответ (done_reason={done_reason}, eval_count={eval_count})."











class SharedFrame:



    def __init__(self) -> None:



        self.lock = threading.Lock()



        self.image: Image.Image | None = None



        self.captured_at = 0.0



        self.error: Exception | None = None



        self.ready = threading.Event()







    def set_image(self, image: Image.Image) -> None:



        with self.lock:



            self.image = image.copy()



            self.captured_at = time.monotonic()



        self.ready.set()







    def get(self) -> tuple[Image.Image | None, float]:



        with self.lock:



            return self.image.copy() if self.image is not None else None, self.captured_at











def capture_worker(stop_event: threading.Event, shared: SharedFrame, monitor: dict) -> None:



    try:



        with mss.MSS() as sct:



            while not stop_event.is_set():



                shared.set_image(capture_rgb(sct, monitor))



                stop_event.wait(CAPTURE_INTERVAL_SECONDS)



    except Exception as exc:



        shared.error = exc



        shared.ready.set()



        stop_event.set()











def model_worker(stop_event: threading.Event, jobs: queue.Queue, results: queue.Queue) -> None:



    client = ollama.Client(host=OLLAMA_HOST, timeout=180.0)



    while not stop_event.is_set():



        try:



            job = jobs.get(timeout=0.25)



        except queue.Empty:



            continue



        if job is None:



            jobs.task_done()



            break



        image, reason = job



        try:



            report = ask_model(client, image, reason)



            results.put((report, None))



        except Exception as exc:



            results.put((None, exc))



        finally:



            jobs.task_done()











