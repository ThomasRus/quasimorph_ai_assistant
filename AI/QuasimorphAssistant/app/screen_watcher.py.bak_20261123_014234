from __future__ import annotations

import io
import queue
import threading
import time
import traceback
from datetime import datetime
from pathlib import Path

import mss
import ollama
from PIL import Image, ImageChops, ImageStat

# -------------------- Configuration --------------------
MODEL = "qwen3-vl:4b-instruct"
OLLAMA_HOST = "http://127.0.0.1:11434"

CAPTURE_INTERVAL_SECONDS = 1.0
ANALYSIS_COOLDOWN_SECONDS = 24.0
HEARTBEAT_SECONDS = 90.0

# Compare the current screen with the last image sent to Qwen, not with
# the immediately previous frame. This filters small frame-to-frame animation.
CHANGE_PIXEL_THRESHOLD = 22
CHANGE_RATIO_THRESHOLD = 0.025       # 2.5% of the 320x180 comparison image
CHANGE_MEAN_THRESHOLD = 2.5          # average grayscale difference, 0..255
CONSECUTIVE_CHANGE_HITS = 2
DIFF_SIZE = (320, 180)
MAX_IMAGE_WIDTH = 1440
STARTUP_COUNTDOWN_SECONDS = 5
MODEL_KEEP_ALIVE = "10m"

BASE_DIR = Path(__file__).resolve().parents[1]
LOG_DIR = BASE_DIR / "logs"
LOG_DIR.mkdir(parents=True, exist_ok=True)
LOG_FILE = LOG_DIR / "screen_watcher.log"

SYSTEM_PROMPT = """
Ты — локальный визуальный наблюдатель игры Quasimorph.
Анализируй ТОЛЬКО приложенный текущий скриншот. Не используй память о прошлых
запусках, старых миссиях, прежних скриншотах или прежних отчётах.

Подтверждённые сведения об интерфейсе от пользователя (приоритетнее предположений модели):
- На HUD миссии большое четырёхзначное число в блоке ресурсов/состояния — это КАЛОРИИ персонажа, НЕ здоровье. Примеры, которые пользователь подтвердил: 1325, 1524, 1515, 1507.
- Отдельное значение здоровья выбранного для миссии наёмника отображалось как 110. Это HP наёмника, НЕ патроны и НЕ AP. Если значение меняется, распознавай число в том же индикаторе здоровья как HP.
- Не называй калории здоровьем. Не называй HP патронами или AP.
- Если скриншот показывает другой экран или не позволяет уверенно сопоставить число с нужным индикатором, укажи «не могу надёжно прочитать» вместо догадки.

Правила достоверности:
- Не выдумывай объекты, текст, характеристики и события.
- Не переноси сведения из предыдущих кадров, миссий или запусков. Текущий кадр оценивай самостоятельно, но используй приведённые выше подтверждённые постоянные знания об интерфейсе.
- Отделяй дословно прочитанный текст от своей интерпретации.
- Используй подтверждённую карту HUD выше. Для всех остальных чисел не угадывай: называй показатель только если его подпись/позиция однозначна.
- Уведомления вида «X умирает», «X страдает от ранения» и подобные описывай как отдельные сообщения о существе X. НЕ утверждай, что это игрок или его состояние, пока экран однозначно не связывает X с выбранным наёмником.
- Не считай любое существо противником, если его принадлежность неясна.
- Если открыт хаб, карта, инвентарь или меню, прямо назови соответствующий экран.
- Если изображение размыто или мелкий текст не читается, укажи это.
- Не давай тактический совет без достаточных оснований.

Ответь кратко, не более 130 слов:
1. Экран: что сейчас открыто.
2. Показатели выбранного наёмника: калории и здоровье раздельно; если не видны, так и напиши.
3. Видимые существа и уведомления: описывай отдельно; не путай уведомление о другом существе с состоянием игрока.
4. Неопределённость: что нельзя надёжно определить.
5. Совет: только если он прямо следует из текущего изображения; иначе напиши «пока нет надёжной рекомендации».
""".strip()


def log_line(message: str) -> None:
    stamp = f"[{datetime.now():%Y-%m-%d %H:%M:%S}] {message}"
    print(stamp, flush=True)
    with LOG_FILE.open("a", encoding="utf-8") as file:
        file.write(stamp + "\n")


def log_report(report: str) -> None:
    stamp = f"[{datetime.now():%Y-%m-%d %H:%M:%S}] Qwen:"
    print("\n" + stamp, flush=True)
    print(report, flush=True)
    with LOG_FILE.open("a", encoding="utf-8") as file:
        file.write(stamp + "\n" + report + "\n\n")


def choose_monitor(monitors: list[dict]) -> int:
    print("\nДоступные области захвата:")
    for index, monitor in enumerate(monitors):
        label = "Все мониторы (единый рабочий стол)" if index == 0 else f"Монитор {index}"
        print(
            f"  {index}: {label} — {monitor['width']}x{monitor['height']} "
            f"(x={monitor['left']}, y={monitor['top']})"
        )
    default = 1 if len(monitors) > 1 else 0
    while True:
        raw = input(f"\nНомер области для захвата [Enter = {default}]: ").strip()
        if not raw:
            return default
        try:
            selected = int(raw)
        except ValueError:
            print("Введите номер цифрами.")
            continue
        if 0 <= selected < len(monitors):
            return selected
        print(f"Допустимый диапазон: 0–{len(monitors) - 1}.")


def capture_rgb(sct: mss.MSS, monitor: dict) -> Image.Image:
    shot = sct.grab(monitor)
    return Image.frombytes("RGB", shot.size, shot.rgb)


def make_diff_image(image: Image.Image) -> Image.Image:
    return image.resize(DIFF_SIZE, Image.Resampling.BILINEAR).convert("L")


def changed_ratio(reference: Image.Image, current: Image.Image) -> tuple[float, float]:
    diff = ImageChops.difference(reference, current)
    mean_difference = ImageStat.Stat(diff).mean[0]
    histogram = diff.histogram()
    changed_pixels = sum(histogram[CHANGE_PIXEL_THRESHOLD + 1 :])
    ratio = changed_pixels / (DIFF_SIZE[0] * DIFF_SIZE[1])
    return ratio, mean_difference


def encode_for_model(image: Image.Image) -> bytes:
    if image.width > MAX_IMAGE_WIDTH:
        new_height = round(image.height * MAX_IMAGE_WIDTH / image.width)
        image = image.resize((MAX_IMAGE_WIDTH, new_height), Image.Resampling.LANCZOS)
    buffer = io.BytesIO()
    image.save(buffer, format="JPEG", quality=90, optimize=True)
    return buffer.getvalue()


def ask_model(client: ollama.Client, image: Image.Image, reason: str) -> str:
    image_bytes = encode_for_model(image)
    prompt = (
        f"Причина анализа: {reason}.\n"
        "Опиши только то, что действительно видно на этом изображении. "
        "Не сравнивай его с предыдущими кадрами и не вспоминай старые события. "
        "Если текст неразборчив, прямо скажи об этом."
    )
    response = client.chat(
        model=MODEL,
        messages=[
            {"role": "system", "content": SYSTEM_PROMPT},
            {"role": "user", "content": prompt, "images": [image_bytes]},
        ],
        keep_alive=MODEL_KEEP_ALIVE,
        options={"temperature": 0.1, "num_predict": 500},
    )
    content = (response.message.content or "").strip()
    if content:
        return content

    # One short retry if the model returned an empty final message.
    retry = client.chat(
        model=MODEL,
        messages=[
            {"role": "system", "content": "Кратко и точно опиши только видимые элементы скриншота Quasimorph. Не додумывай."},
            {"role": "user", "content": "Что видно на этом скриншоте? Если определить нельзя, скажи об этом.", "images": [image_bytes]},
        ],
        keep_alive=MODEL_KEEP_ALIVE,
        options={"temperature": 0.1, "num_predict": 300},
    )
    content = (retry.message.content or "").strip()
    if content:
        return content
    done_reason = getattr(retry, "done_reason", None) or "unknown"
    eval_count = getattr(retry, "eval_count", None)
    return f"Модель дважды вернула пустой ответ (done_reason={done_reason}, eval_count={eval_count})."


class SharedFrame:
    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.image: Image.Image | None = None
        self.captured_at = 0.0
        self.error: Exception | None = None
        self.ready = threading.Event()

    def set_image(self, image: Image.Image) -> None:
        with self.lock:
            self.image = image.copy()
            self.captured_at = time.monotonic()
        self.ready.set()

    def get(self) -> tuple[Image.Image | None, float]:
        with self.lock:
            return self.image.copy() if self.image is not None else None, self.captured_at


def capture_worker(stop_event: threading.Event, shared: SharedFrame, monitor: dict) -> None:
    try:
        with mss.MSS() as sct:
            while not stop_event.is_set():
                shared.set_image(capture_rgb(sct, monitor))
                stop_event.wait(CAPTURE_INTERVAL_SECONDS)
    except Exception as exc:
        shared.error = exc
        shared.ready.set()
        stop_event.set()


def model_worker(stop_event: threading.Event, jobs: queue.Queue, results: queue.Queue) -> None:
    client = ollama.Client(host=OLLAMA_HOST, timeout=180.0)
    while not stop_event.is_set():
        try:
            job = jobs.get(timeout=0.25)
        except queue.Empty:
            continue
        if job is None:
            jobs.task_done()
            break
        image, reason = job
        try:
            report = ask_model(client, image, reason)
            results.put((report, None))
        except Exception as exc:
            results.put((None, exc))
        finally:
            jobs.task_done()


def main() -> int:
    print("=" * 70)
    print("Quasimorph Assistant — Screen Watcher v1.6")
    print(f"Модель: {MODEL}")
    print(f"Захват экрана: каждые {CAPTURE_INTERVAL_SECONDS:.1f} с")
    print(f"Минимальная пауза между анализами: {ANALYSIS_COOLDOWN_SECONDS:.0f} с")
    print(f"Порог изменения: {CHANGE_RATIO_THRESHOLD * 100:.1f}% пикселей и средняя разница {CHANGE_MEAN_THRESHOLD:.1f}")
    print(f"Контрольный анализ без изменений: каждые {HEARTBEAT_SECONDS:.0f} с")
    print("Сравнение идёт с последним кадром, отправленным Qwen; мелкая анимация фильтруется.")
    print("Qwen получает только текущий кадр — старые отчёты не передаются в контекст.")
    print("Скриншоты не сохраняются и отправляются только локальному Ollama.")
    print("Остановка: Ctrl+C в этом окне.")
    print("=" * 70)

    client = ollama.Client(host=OLLAMA_HOST, timeout=30.0)
    try:
        client.list()
    except Exception as exc:
        print(f"Не удалось подключиться к Ollama на {OLLAMA_HOST}: {exc}")
        print("Убедись, что Ollama запущена.")
        return 2

    with mss.MSS() as sct:
        monitors = sct.monitors
        if len(monitors) < 2:
            print("Не удалось обнаружить монитор для захвата.")
            return 3
        selected = choose_monitor(monitors)
        monitor = dict(monitors[selected])

    print("\nПереключись в Quasimorph. Начинаю захват через:")
    for remaining in range(STARTUP_COUNTDOWN_SECONDS, 0, -1):
        print(f"  {remaining}...", end="\r", flush=True)
        time.sleep(1)

    stop_event = threading.Event()
    shared = SharedFrame()
    jobs: queue.Queue = queue.Queue(maxsize=1)
    results: queue.Queue = queue.Queue()
    capture_thread = threading.Thread(target=capture_worker, args=(stop_event, shared, monitor), daemon=True)
    ai_thread = threading.Thread(target=model_worker, args=(stop_event, jobs, results), daemon=True)
    capture_thread.start()
    ai_thread.start()

    if not shared.ready.wait(timeout=10):
        print("Не удалось получить первый кадр с экрана.")
        stop_event.set()
        return 4
    if shared.error:
        print(f"Ошибка захвата экрана: {shared.error}")
        stop_event.set()
        return 5

    initial_image, initial_ts = shared.get()
    if initial_image is None:
        print("Первый кадр пустой.")
        stop_event.set()
        return 6

    reference_small = make_diff_image(initial_image)
    last_seen_capture_ts = initial_ts
    last_analysis_at = 0.0
    analysis_busy = False
    consecutive_hits = 0
    pending_image: Image.Image | None = None
    pending_reason = ""

    def submit(image: Image.Image, reason: str) -> None:
        nonlocal analysis_busy, last_analysis_at, reference_small, consecutive_hits, pending_image, pending_reason
        try:
            jobs.put_nowait((image.copy(), reason))
        except queue.Full:
            return
        # Move the comparison baseline to the exact image sent to the model.
        reference_small = make_diff_image(image)
        analysis_busy = True
        last_analysis_at = time.monotonic()
        consecutive_hits = 0
        pending_image = None
        pending_reason = ""
        log_line(f"Отправлен кадр на анализ: {reason}")

    print("\nНаблюдение запущено. Первичный анализ отправляется модели.", flush=True)
    submit(initial_image, "первичный снимок текущей сессии")

    try:
        while not stop_event.is_set():
            time.sleep(0.20)

            if shared.error:
                log_line(f"Ошибка захвата экрана: {shared.error}")
                break

            while True:
                try:
                    report, error = results.get_nowait()
                except queue.Empty:
                    break
                analysis_busy = False
                if error is not None:
                    log_line(f"Ошибка анализа Qwen: {error}")
                elif report:
                    log_report(report)
                results.task_done()

            current_image, captured_at = shared.get()
            if current_image is not None and captured_at != last_seen_capture_ts:
                last_seen_capture_ts = captured_at
                current_small = make_diff_image(current_image)
                ratio, mean_diff = changed_ratio(reference_small, current_small)
                changed_enough = ratio >= CHANGE_RATIO_THRESHOLD and mean_diff >= CHANGE_MEAN_THRESHOLD

                if changed_enough:
                    consecutive_hits += 1
                    pending_image = current_image.copy()
                    pending_reason = (
                        f"устойчивое изменение относительно предыдущего анализа: "
                        f"{ratio * 100:.1f}% пикселей, средняя разница {mean_diff:.1f}"
                    )
                else:
                    consecutive_hits = 0

                # Keep the candidate frame after two consecutive qualifying captures.
                if consecutive_hits < CONSECUTIVE_CHANGE_HITS and pending_image is not None:
                    # A previous transient event remains a candidate until it is analyzed.
                    pass

            now = time.monotonic()
            cooldown_passed = (now - last_analysis_at) >= ANALYSIS_COOLDOWN_SECONDS
            heartbeat_due = (now - last_analysis_at) >= HEARTBEAT_SECONDS

            if not analysis_busy and cooldown_passed:
                if pending_image is not None:
                    submit(pending_image, pending_reason or "изменение экрана")
                elif heartbeat_due:
                    latest_image, _ = shared.get()
                    if latest_image is not None:
                        submit(latest_image, "периодическая проверка текущего состояния")

    except KeyboardInterrupt:
        print("\nОстановка наблюдателя...")
    finally:
        stop_event.set()
        try:
            jobs.put_nowait(None)
        except queue.Full:
            pass
        capture_thread.join(timeout=2.0)
        ai_thread.join(timeout=2.0)
        print("Наблюдение остановлено.")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("\nНаблюдение остановлено пользователем.")
    except Exception:
        traceback.print_exc()
        input("Произошла непредвиденная ошибка. Нажми Enter для выхода...")
