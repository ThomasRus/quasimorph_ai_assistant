        "gameplay",
        scene_system,
        scene_prompt,
        hud_context_bytes,
        400,
    )

    return (
        "=== HUD: \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0438 "
        "\u043d\u0430\u0451\u043c\u043d\u0438\u043a\u0430 ===\n"
        + hud_report
        + "\n\n=== "
        "\u0418\u0433\u0440\u043e\u0432\u0430\u044f "
        "\u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f ===\n"
        + scene_report
    )


class SharedFrame:







    def __init__(self) -> None:







        self.lock = threading.Lock()







        self.image: Image.Image | None = None







        self.captured_at = 0.0







        self.error: Exception | None = None







        self.ready = threading.Event()















    def set_image(self, image: Image.Image) -> None:







        with self.lock:







            self.image = image.copy()







            self.captured_at = time.monotonic()







        self.ready.set()















    def get(self) -> tuple[Image.Image | None, float]:







        with self.lock:







            return self.image.copy() if self.image is not None else None, self.captured_at























def capture_worker(stop_event: threading.Event, shared: SharedFrame, monitor: dict) -> None:







    try:







        with mss.MSS() as sct:







            while not stop_event.is_set():







                shared.set_image(capture_rgb(sct, monitor))







                stop_event.wait(CAPTURE_INTERVAL_SECONDS)







    except Exception as exc:







        shared.error = exc







        shared.ready.set()







        stop_event.set()























def model_worker(stop_event: threading.Event, jobs: queue.Queue, results: queue.Queue) -> None:







    client = ollama.Client(host=OLLAMA_HOST, timeout=180.0)







    while not stop_event.is_set():







        try:







            job = jobs.get(timeout=0.25)







        except queue.Empty:







            continue







        if job is None:







            jobs.task_done()







            break







        image, reason = job







        try:







            report = ask_model(client, image, reason)







            results.put((report, None))







        except Exception as exc:







            results.put((None, exc))







        finally:







            jobs.task_done()























